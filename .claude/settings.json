{
  "permissions": {
    "deny": [
      "Read(/.env*)",
      "Edit(/.env*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(/.[eE][nN][vV]*)",
      "Edit(/.[eE][nN][vV]*)",
      "Read(**/.[eE][nN][vV]*)",
      "Edit(**/.[eE][nN][vV]*)",
      "Read(/.streamlit/secrets.toml)",
      "Edit(/.streamlit/secrets.toml)",
      "Read(**/.streamlit/secrets.toml)",
      "Edit(**/.streamlit/secrets.toml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/py-checks.sh\""
          }
        ]
      }
    ]
  }
}
